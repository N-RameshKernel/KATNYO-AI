# Optional local defaults. AI provider keys are entered in the provider session dialog.
KATNYO_CHAT_PROVIDER=local
KATNYO_MAX_PROFILE_ROWS=50000
KATNYO_MAX_TRAIN_ROWS=30000
KATNYO_OPTUNA_TRIALS=8
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=KATNYO AI

# Supabase Auth + private CSV Storage (publishable key only; never use a service-role key)
KATNYO_AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
KATNYO_SUPABASE_STORAGE_BUCKET=katnyo-user-data
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
COHERE_MODEL=command-a-plus-05-2026

WANDB_PROJECT=katnyo-ai
NEPTUNE_PROJECT=
RAY_TUNE_ENABLED=false
H2O_AUTOML_ENABLED=false
